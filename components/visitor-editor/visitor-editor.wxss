/* 预约人编辑弹层 */

/* 全屏遮罩：半透明黑色，垂直水平居中（层级高于普通弹窗） */
.ve-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 居中的白色表单弹层卡片 */
.ve-box {
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 28rpx;
}
.ve-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 表单区：顶部与行间用细分隔线划分 */
.ve-form {
  border-top: 2rpx solid var(--line, #EEEEEE);
}

/* 每一行表单项：标签 + 输入框横排 */
.ve-cell {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line, #EEEEEE);
}
.ve-label {
  width: 170rpx;
  font-size: 28rpx;
  color: var(--text-main, #2B2B2B);
  flex-shrink: 0;
}
.ve-input {
  flex: 1;
  font-size: 28rpx;
}
/* 默认开关条：去掉底部分隔线 */
.ve-switch {
  border-bottom: none;
}

/* 自定义开关：灰色圆角底，开启时变主题红 */
.ve-toggle {
  margin-left: auto;
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #E5E2DD;
  position: relative;
  transition: background 0.2s;
}
.ve-toggle-on {
  background: var(--primary, var(--primary));
}

/* 开关滑块：圆点，开启时向右滑动（left 偏移 + 过渡动画） */
.ve-toggle-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  transition: left 0.2s;
}
.ve-toggle-on .ve-toggle-dot {
  left: 44rpx;
}
.ve-tip {
  margin: 20rpx 0 24rpx;
  font-size: 22rpx;
  color: var(--text-sub, #8A8A8A);
  line-height: 1.7;
}

/* 取消按钮：弱化小字 */
.ve-cancel {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light, #B5B5B5);
}
