/**
 * 红色纪念馆 - 全局样式
 * 主题：庄重红色调（深红 #C8102E + 暖纸白 #F5F3F0 + 金色点缀 #C9A063）
 */
page {
  /* 主题色板 */
  --primary: #C8102E;
  --primary-dark: #9E0B20;
  --primary-light: #F8E5E8;
  --red-bright: #D92543; /* 主题红渐变 - 亮端 */
  --red-deep: #A80F28;   /* 主题红渐变 - 暗端 */
  --gold: #C9A063;
  --gold-light: #F4E9D8;
  --gold-text: #A07C38;  /* 金色文字（在浅金背景上） */
  --bg: #F5F3F0;
  --card: #FFFFFF;
  --text-main: #2B2B2B;
  --text-sub: #7A7A7A;
  --text-light: #B0B0B0;
  --line: #ECECEC;
  --success: #2E9E5B;
  --warning: #E08A00;
  --danger: #D43D3D;
  --info: #3D7EDB;

  /* 纸张纹理背景：暖色底 + 极淡纤维纹路，模拟宣纸质感 */
  background-color: var(--bg);
  background-image:
    repeating-linear-gradient(
      45deg,
      rgba(160, 124, 56, 0.018) 0px,
      rgba(160, 124, 56, 0.018) 1px,
      transparent 1px,
      transparent 6px
    ),
    repeating-linear-gradient(
      -45deg,
      rgba(160, 124, 56, 0.014) 0px,
      rgba(160, 124, 56, 0.014) 1px,
      transparent 1px,
      transparent 8px
    ),
    radial-gradient(
      ellipse at 20% 30%,
      rgba(160, 124, 56, 0.04) 0%,
      transparent 50%
    ),
    radial-gradient(
      ellipse at 80% 70%,
      rgba(160, 124, 56, 0.03) 0%,
      transparent 50%
    );
  background-attachment: fixed;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

view, text, image, button, input, textarea, scroll-view, navigator {
  box-sizing: border-box;
}

/* ========== 通用布局 ========== */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}
.container {
  padding: 24rpx;
}

/* ========== 卡片 ========== */
.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
  border: none;
  padding: 0 40rpx;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, var(--red-bright) 0%, var(--primary) 60%, var(--red-deep) 100%);
  color: #FFFFFF;
}
.btn-primary.btn-hover {
  opacity: 0.85;
}
.btn-plain {
  background: #FFFFFF;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}
.btn-ghost {
  background: transparent;
  color: var(--text-sub);
  border: 2rpx solid var(--line);
}
.btn-disabled {
  background: #E3E0DB;
  color: #A9A6A1;
}
.btn-sm {
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
}
.btn-block {
  width: 100%;
}
.btn-loading {
  opacity: 0.7;
}

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.tag-red {
  background: var(--primary-light);
  color: var(--primary);
}
.tag-gold {
  background: var(--gold-light);
  color: var(--gold-text);
}
.tag-green {
  background: #E4F4EA;
  color: var(--success);
}
.tag-gray {
  background: #F0EFEC;
  color: var(--text-sub);
}
.tag-blue {
  background: #E8F0FC;
  color: var(--info);
}
.tag-orange {
  background: #FCF0DF;
  color: var(--warning);
}

/* ========== 区块标题 ========== */
.section {
  margin: 8rpx 0 20rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
}
.section-title::before {
  content: "";
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--red-bright), var(--red-deep));
  margin-right: 14rpx;
}
.section-more {
  font-size: 26rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
}
.section-more::after {
  content: "›";
  margin-left: 4rpx;
  font-size: 30rpx;
}

/* ========== 列表 ========== */
.cell {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
  position: relative;
}
.cell:last-child {
  border-bottom: none;
}
.cell-label {
  width: 180rpx;
  color: var(--text-sub);
  font-size: 28rpx;
  flex-shrink: 0;
}
.cell-value {
  flex: 1;
  color: var(--text-main);
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}
.cell-arrow::after {
  content: "›";
  color: var(--text-light);
  font-size: 34rpx;
  margin-left: 12rpx;
}
.cell-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

/* ========== 表单 ========== */
.form-card .cell {
  padding: 30rpx 0;
}
.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}
.picker-placeholder {
  color: var(--text-light);
}
.textarea-box {
  width: 100%;
  background: #FAF9F7;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}
.textarea-box textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
}
.upload-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.upload-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
  position: relative;
  overflow: hidden;
}
.upload-item image {
  width: 100%;
  height: 100%;
}
.upload-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFF;
  font-size: 28rpx;
  text-align: center;
  line-height: 40rpx;
  border-radius: 0 0 0 12rpx;
}
.upload-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #D8D4CE;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-light);
  font-size: 22rpx;
  background: #FAF9F7;
}
.upload-add .plus {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

/* ========== 状态色 ========== */
.st-pending { color: var(--warning); }
.st-approved { color: var(--success); }
.st-rejected { color: var(--danger); }
.st-canceled { color: var(--text-light); }
.st-used { color: var(--info); }

/* ========== 工具类 ========== */
.flex {
  display: flex;
  align-items: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.text-main { color: var(--text-main); }
.text-sub { color: var(--text-sub); }
.text-light { color: var(--text-light); }
.text-primary { color: var(--primary); }
.text-gold { color: var(--gold-text); }
.text-danger { color: var(--danger); }
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.text-2lines {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
.font-sm { font-size: 24rpx; }
.font-xs { font-size: 22rpx; }
.font-lg { font-size: 36rpx; }
.font-bold { font-weight: 600; }
.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mb16 { margin-bottom: 16rpx; }
.mb24 { margin-bottom: 24rpx; }
.ml8 { margin-left: 8rpx; }
.ml16 { margin-left: 16rpx; }
.mr8 { margin-right: 8rpx; }
.mr16 { margin-right: 16rpx; }
.p16 { padding: 16rpx; }
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* ========== 通用组件样式 ========== */
.cover-img {
  width: 100%;
  border-radius: 12rpx;
  display: block;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E9E6E1;
}

/* 底栏安全区 */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}
