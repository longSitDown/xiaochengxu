# 红色纪念馆小程序 —— 后端环境配置
# 复制为 server/.env 后填写；该文件含密钥，务必加入 .gitignore，不要提交

# 监听端口（生产建议 127.0.0.1 + Nginx 反代）
PORT=3000
HOST=0.0.0.0

# ---------- 明道云 ----------
# SaaS 环境固定 https://api.mingdao.com；私有部署填 https://<host>/api
HAP_BASE=https://api.mingdao.com
# 应用后台 → 授权管理 → 新建授权密钥
HAP_APPKEY=
HAP_SECRET=
# 签名变体，先用 tools/sign-probe.js 探测出正确值再填
# 格式：<拼接方式>|<摘要编码>，可选 kv|kvnl|plain|json 与 b64hex|b64raw|hex
HAP_SIGN_VARIANT=kv|b64hex
# users 工作表的 worksheetId；留空则自动读 config/tables.js 的 users
HAP_USERS_WORKSHEET=

# ---------- 微信小程序 ----------
# 微信公众平台 → 开发管理 → 开发设置
WX_APPID=wx274ab15916adcc7c
WX_SECRET=

# ---------- 登录态 ----------
# 换成 32 位以上随机串，可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# token 有效期（秒），默认 7 天
TOKEN_TTL=604800

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
# 对外可访问基地址，用于拼头像 URL（生产填 https://api.你的域名.com）
PUBLIC_BASE=
UPLOAD_MAX=2097152

# ---------- 联调开关 ----------
# 置 1 可跳过微信与明道云直接发 token，只用于先把前端登录流程跑通。生产必须为 0
MOCK_LOGIN=0
