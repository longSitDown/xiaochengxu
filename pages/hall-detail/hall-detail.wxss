/* 展区详情样式 */
.page {
  padding-bottom: 200rpx; /* 给播放条留空间 */
}

/* 头部 */
.head {
  position: relative;
  height: 400rpx;
}
.head-bg {
  width: 100%;
  height: 100%;
}
/* 黑色渐变蒙层，压暗背景图保证底部标题文字可读 */
.head-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.65) 100%);
}
.head-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 32rpx 32rpx;
  color: #FFFFFF;
}
.head-name {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.head-desc {
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.head-btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 列表 */
.list-head {
  display: flex;
  align-items: center;
  margin: 28rpx 0 20rpx;
}
.list-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--red-bright), var(--red-deep));
  margin-right: 14rpx;
}
.list-title {
  font-size: 34rpx;
  font-weight: 600;
}
.list-count {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

/* 展品卡片 */
.art-card {
  display: flex;
  padding: 20rpx;
}
.art-cover-box {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.art-cover {
  width: 100%;
  height: 100%;
}
.art-highlight {
  position: absolute;
  top: 0;
  left: 0;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  color: #FFF;
  font-size: 20rpx;
  border-radius: 0 0 12rpx 0;
}
.art-views {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #FFF;
  background: rgba(0, 0, 0, 0.45);
}
.art-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.art-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}
.art-script {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
  flex: 1;
}
.art-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.art-duration {
  font-size: 22rpx;
  color: var(--text-light);
}
.art-play {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 24rpx;
}
.art-playing {
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  color: #FFF;
}
.play-triangle {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid currentColor;
  margin-right: 10rpx;
}
/* 播放中的等宽波形动画条：三根柱子错峰缩放 */
.play-bars {
  display: flex;
  align-items: flex-end;
  height: 24rpx;
  margin-right: 10rpx;
}
.play-bars .bar {
  width: 6rpx;
  background: #FFF;
  margin-right: 4rpx;
  border-radius: 3rpx;
  animation: barWave 0.9s ease-in-out infinite;
}
.play-bars .bar:nth-child(1) { height: 40%; animation-delay: 0s; }
.play-bars .bar:nth-child(2) { height: 100%; animation-delay: 0.2s; }
.play-bars .bar:nth-child(3) { height: 65%; animation-delay: 0.4s; }
@keyframes barWave {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1); }
}
