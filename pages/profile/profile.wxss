/* 我的样式 */
/* 顶部用户信息卡片：红色渐变背景头部 */
.user-hero {
  display: flex;
  align-items: center;
  padding: 56rpx 40rpx 44rpx;
  background: linear-gradient(160deg, var(--red-bright) 0%, var(--primary) 55%, var(--red-deep) 100%);
  color: #FFF;
}

/* 用户头像：圆形，带半透明白描边 */
.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 28rpx;
  flex-shrink: 0;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
/* 昵称行右侧的"修改"小标签 */
.user-edit {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 400;
  opacity: 0.9;
}
.user-phone {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}
/* 游客状态下的一键登录按钮：白色胶囊 */
.user-login-btn {
  padding: 12rpx 36rpx;
  background: #FFF;
  color: var(--primary);
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 统计 */
.stat-card {
  display: flex;
  background: #FFF;
  border-radius: 16rpx;
  padding: 30rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}
.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 菜单 */
.menu-card .cell {
  padding: 28rpx 0;
}
.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  margin-right: 22rpx;
  position: relative;
  flex-shrink: 0;
}
/* 菜单项图标底色：按菜单类型取不同渐变区分 */
.mi-resv { background: linear-gradient(135deg, #D8A75E, #B8860B); }
.mi-visitor { background: linear-gradient(135deg, #C8785E, #A0522D); }
.mi-quiz { background: linear-gradient(135deg, #E0604F, #C0392B); }
.mi-feedback { background: linear-gradient(135deg, #9B85C0, #6E56A8); }
.mi-guide { background: linear-gradient(135deg, #4A7BD0, #2C5FA8); }
.mi-about { background: linear-gradient(135deg, #52A882, #2E8B57); }
.mi-reset { background: linear-gradient(135deg, #8A8A8A, #5A5A5A); }

/* 简易图标：用 CSS 伪元素在渐变底色上绘制各菜单图标（预约/访客/答题等） */
.mi-resv::before {
  content: "";
  position: absolute;
  inset: 10rpx 14rpx;
  border: 4rpx solid #FFF;
  border-radius: 6rpx;
}
.mi-visitor::before {
  content: "";
  position: absolute;
  inset: 12rpx 16rpx 10rpx 16rpx;
  background: #FFF;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
}
.mi-visitor::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 22rpx;
  height: 16rpx;
  margin-left: -11rpx;
  background: #FFF;
  border-radius: 10rpx 10rpx 0 0;
}
.mi-quiz::before {
  content: "?";
  position: absolute;
  inset: 0;
  color: #FFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mi-feedback::before {
  content: "";
  position: absolute;
  inset: 10rpx 14rpx;
  border: 4rpx solid #FFF;
  border-radius: 10rpx 10rpx 10rpx 2rpx;
}
.mi-guide::before {
  content: "";
  position: absolute;
  inset: 8rpx;
  background: #FFF;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
.mi-about::before {
  content: "i";
  position: absolute;
  inset: 0;
  color: #FFF;
  font-size: 30rpx;
  font-weight: 700;
  font-style: italic;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mi-reset::before {
  content: "";
  position: absolute;
  inset: 10rpx;
  border: 4rpx solid #FFF;
  border-radius: 50%;
  clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
}
.mi-reset::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 0;
  height: 0;
  margin-left: -8rpx;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 12rpx solid #FFF;
}
.menu-name {
  font-size: 28rpx;
  color: var(--text-main);
}

/* 页脚版权文案 */
.profile-copyright {
  text-align: center;
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--text-light);
  letter-spacing: 2rpx;
}
