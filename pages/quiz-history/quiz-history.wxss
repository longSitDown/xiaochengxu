/* 我的战绩样式 */
/* 最佳成绩卡：红色渐变横幅，左侧分数右侧统计 */
.best-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--red-bright) 0%, var(--primary) 60%, var(--red-deep) 100%);
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(168, 15, 40, 0.25);
}
/* 左侧分数区：右边界分隔线 */
.best-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 40rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.3);
}
.best-score {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.1;
}
.best-unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 4rpx;
}
.best-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.85;
}
.best-right {
  flex: 1;
  padding-left: 40rpx;
}
.best-line {
  font-size: 26rpx;
  line-height: 1.9;
  opacity: 0.95;
}

.empty-btn {
  margin-top: 24rpx;
}

/* 记录卡片：每条历史记录一条卡 */
.rec-card {
  position: relative;
}
.rec-head {
  display: flex;
  align-items: center;
}
.rec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
/* 记录分数：主色高亮 */
.rec-score {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
  margin-left: 16rpx;
}
/* 记录元信息行：正确率标签 + 答对题数 + 用时 + 时间 */
.rec-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.rec-meta-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
.rec-meta-time {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-light);
}
.rec-arrow {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--primary);
}
