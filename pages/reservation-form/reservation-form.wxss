/* 预约表单样式：公告条 + 月历 + 场次 + 分步底部栏 */
.block-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
/* 区块标题左侧红色装饰条（伪元素用不了，故用实体块级元素） */
.block-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--red-bright), var(--red-deep));
  margin-right: 14rpx;
}

.reschedule-tip {
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  background: var(--gold-light);
  color: var(--gold-text);
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

/* ---- 顶部公告条（喇叭 + 滚动提示） ---- */
.notice-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #FBF4E4, #F5E9CE);
}
.notice-horn {
  font-size: 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.notice-swiper {
  flex: 1;
  height: 76rpx;
}
.notice-text {
  line-height: 76rpx;
  font-size: 24rpx;
  color: var(--red-deep);
}

/* ---- 月历（参观日期） ---- */
.cal-card {
  padding-bottom: 16rpx;
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cal-head .block-title {
  margin-bottom: 20rpx;
}
.cal-month {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-sub);
}
.cal-month-text {
  color: var(--red-deep);
  font-weight: 600;
}
.cal-month-next {
  padding: 6rpx 0 6rpx 20rpx;
}
/* 星期表头 */
.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}
.cal-week text {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
}
.cal-weekend {
  color: var(--primary);
}
/* 日历网格：7 列 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: 14.28%;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cal-blank {
  pointer-events: none;
}
.cal-day {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-main);
  background: #FFFFFF;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
/* 范围外：灰字无圈 */
.cal-out .cal-day {
  color: #C9C4BC;
  background: transparent;
}
/* 可约：白底红边 */
.cal-open .cal-day {
  border-color: var(--red-deep);
  color: var(--red-deep);
  font-weight: 600;
}
/* 约满：米色圈灰字 */
.cal-full .cal-day {
  background: #EFE6D2;
  color: #A99C86;
}
/* 选中：深红实心白字 */
.cal-selected .cal-day {
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(200, 16, 46, 0.35);
}
/* 日期下方状态小字（可约/约满） */
.cal-mark {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-light);
  line-height: 1;
}
.cal-open .cal-mark {
  color: var(--red-deep);
}
.cal-selected .cal-mark {
  color: var(--red-deep);
  font-weight: 600;
}

/* ---- 场次选择：均分大卡片，选中红框、disabled 半透明 ---- */
.slot-row {
  display: flex;
}
.slot-item {
  flex: 1;
  padding: 36rpx 0;
  text-align: center;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: #FAF9F7;
  transition: all 0.2s;
}
.slot-item:first-child {
  margin-right: 20rpx;
}
.slot-active {
  border-color: var(--red-deep);
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(200, 16, 46, 0.12);
}
.slot-disabled {
  opacity: 0.45;
}
.slot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.slot-active .slot-name {
  color: var(--red-deep);
}
/* 剩余名额：余量少时用警告色提示用户 */
.slot-quota {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--success);
}
.slot-quota-low {
  color: var(--warning);
}
.slot-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light);
}

/* ---- 类型选择：个人/团体左右均分卡片 ---- */
.type-row {
  display: flex;
}
.type-item {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  background: #FAF9F7;
}
.type-item:first-child {
  margin-right: 20rpx;
}
.type-active {
  border-color: var(--primary);
  background: var(--primary-light);
}
.type-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.type-active .type-name {
  color: var(--primary);
}
.type-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

/* ---- 步进器 ---- */
.stepper {
  display: flex;
  align-items: center;
  margin-left: auto;
}
.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #F5F3F0;
  color: var(--text-main);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stepper-num {
  width: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.remark-input {
  text-align: left;
  min-height: 120rpx;
  padding: 12rpx;
  background: #FAF9F7;
  border-radius: 8rpx;
}

/* ---- 温馨提示 ---- */
.tips-card {
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #FAF9F7;
  border: 2rpx dashed #D8D4CE;
}
.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-text);
  margin-bottom: 12rpx;
}
.tips-line {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.9;
}

/* ---- 底部固定栏：已选摘要 + 下一步/提交 ---- */
.bottom-space {
  height: 200rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #FBF4E4, #F5E9CE);
  box-shadow: 0 -4rpx 20rpx rgba(120, 8, 24, 0.08);
  z-index: 100;
}
.bottom-info {
  flex: 1;
  min-width: 0;
}
.bottom-date {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--red-deep);
}
.bottom-slot {
  font-size: 24rpx;
  color: #8A6F45;
  margin-top: 4rpx;
}
.bottom-back {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 36rpx;
  margin-right: 20rpx;
  border-radius: 44rpx;
  border: 2rpx solid var(--red-deep);
  color: var(--red-deep);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
}
.bottom-btn {
  flex-shrink: 0;
  min-width: 260rpx;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(200, 16, 46, 0.35);
}
.bottom-btn-disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* ---- 实名参观人 ---- */
.visitor-cell {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.visitor-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.visitor-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.visitor-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}
.visitor-idcard {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.visitor-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-light);
  font-size: 36rpx;
}
.visitor-add {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
  font-size: 28rpx;
  color: var(--primary);
}
.visitor-add-plus {
  margin-right: 14rpx;
  font-size: 30rpx;
}
.visitor-add-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-sub);
}
.form-tip {
  margin: 18rpx 0 24rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

/* ---- 联系人（团体） ---- */
.contact-head {
  display: flex;
  align-items: center;
  padding: 26rpx 0 6rpx;
}
.contact-pick {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--primary);
  padding: 8rpx 22rpx;
  border: 2rpx solid var(--primary-light);
  border-radius: 26rpx;
}

/* ---- 选择弹层：全屏 mask 半透明背景，内容用 flex 垂直水平居中 ---- */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.picker-box {
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
}
.picker-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}
.picker-list {
  max-height: 520rpx;
}
.picker-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light);
}
.picker-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.picker-item-checked .visitor-name {
  color: var(--primary);
}
.picker-default {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 20rpx;
  vertical-align: middle;
}
.picker-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D8D4CE;
  flex-shrink: 0;
}
.picker-check-on {
  border-color: var(--primary);
  background: var(--primary);
  position: relative;
}
/* 选中的圆圈：伪元素 ::after 画白色对勾 */
.picker-check-on::after {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 6rpx;
  width: 10rpx;
  height: 20rpx;
  border: solid #FFFFFF;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}
.picker-quick {
  margin: 24rpx 0 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
}
