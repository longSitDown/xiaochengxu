/* 文物详情：上大图 + 米色信息面板 + 底部操作栏 */
.page {
  padding-bottom: 160rpx; /* 给固定操作栏留出空间 */
}

/* ---- 展品大图 ---- */
.hero {
  position: relative;
  height: 860rpx;
  background: #F2EFE8;
}
.hero-img {
  width: 100%;
  height: 100%;
}
/* 红色「文物」印章（右上角，窄宽度使两字自动竖排） */
.hero-seal {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 64rpx;
  padding: 12rpx 0;
  border-radius: 10rpx;
  background: rgba(196, 24, 42, 0.92);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.35;
  letter-spacing: 0;
  box-shadow: 0 4rpx 12rpx rgba(120, 8, 24, 0.3);
}
.hero-views {
  position: absolute;
  left: 24rpx;
  bottom: 120rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #FFFFFF;
  font-size: 22rpx;
}

/* ---- 信息面板（米色，上移盖住大图） ---- */
.panel {
  position: relative;
  margin-top: -72rpx;
  background: #F7F2E7;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 48rpx;
  min-height: 500rpx;
}
.panel-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--red-deep);
  line-height: 1.4;
  margin-bottom: 18rpx;
}
.panel-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.p-tag {
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(168, 15, 40, 0.10);
  color: var(--red-deep);
  font-size: 24rpx;
  margin-right: 16rpx;
}
.p-period {
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(160, 124, 56, 0.14);
  color: var(--gold-text);
  font-size: 24rpx;
  margin-right: 16rpx;
}
.p-highlight {
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--red-deep);
  color: var(--red-deep);
  font-size: 24rpx;
}
.panel-desc {
  font-size: 28rpx;
  color: #5A4636;
  line-height: 1.9;
  text-align: justify;
  margin-bottom: 36rpx;
}

/* ---- 语音讲解 ---- */
.play-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(120, 8, 24, 0.06);
}
.play-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-left: 24rpx solid #FFFFFF;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
}
.play-bars {
  display: flex;
  align-items: center;
  height: 40rpx;
}
.play-bars .bar {
  width: 6rpx;
  margin: 0 4rpx;
  background: #FFFFFF;
  border-radius: 3rpx;
  animation: playbar 0.9s ease-in-out infinite alternate;
}
.play-bars .bar:nth-child(1) { height: 20rpx; animation-delay: 0s; }
.play-bars .bar:nth-child(2) { height: 36rpx; animation-delay: 0.2s; }
.play-bars .bar:nth-child(3) { height: 26rpx; animation-delay: 0.4s; }
.play-bars .bar:nth-child(4) { height: 32rpx; animation-delay: 0.6s; }
@keyframes playbar {
  from { transform: scaleY(0.5); }
  to { transform: scaleY(1.2); }
}
.play-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.play-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

/* ---- 所在展区 ---- */
.exh-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(120, 8, 24, 0.06);
}
.exh-label {
  font-size: 28rpx;
  color: var(--text-main);
}
.exh-arrow {
  font-size: 26rpx;
  color: var(--primary);
}

/* ---- 底部操作栏：收藏 + 分享 ---- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.action-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  border: 2rpx solid var(--red-deep);
  color: var(--red-deep);
  font-size: 30rpx;
  background: #FFFFFF;
  margin: 0;
  padding: 0;
  line-height: 1;
}
.action-item::after {
  border: none;
}
.action-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}
.action-faved {
  background: var(--red-deep);
  color: #FFFFFF;
}
.action-share {
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  color: #FFFFFF;
  border-color: transparent;
}
