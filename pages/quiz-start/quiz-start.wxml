<!-- 答题页：倒计时 + 题目卡片 + 选项 -->
<view class="qs-page" wx:if="{{questions.length}}">
  <!-- 顶部：题目进度 + 剩余倒计时 -->
  <view class="qs-top">
    <view class="qs-progress">第 {{current + 1}} / {{questions.length}} 题</view>
    <view class="qs-timer">剩余 {{remainText}}</view>
  </view>
  <!-- 答题进度条：宽度随当前题号百分比变化 -->
  <view class="qs-bar">
    <view class="qs-bar-inner" style="width: {{(current + 1) / questions.length * 100}}%"></view>
  </view>

  <view class="container">
    <!-- 当前题目卡片：只渲染当前题，用 index === current 控制切换 -->
    <block wx:for="{{questions}}" wx:key="id" wx:if="{{index === current}}">
      <view class="card q-card">
        <view class="q-head">
          <!-- 题型标识：单选/多选/判断 映射不同配色 -->
          <view class="q-type q-type-{{item.type === '单选' ? 'single' : (item.type === '多选' ? 'multi' : 'judge')}}">{{item.type}}</view>
          <text class="q-score">{{item.score}} 分</text>
        </view>
        <view class="q-title">{{item.title}}</view>
        <!-- 多选专属提示 -->
        <view class="q-hint" wx:if="{{item.type === '多选'}}">多选题：请选择所有正确选项</view>

        <!-- 选项列表：点击选择/取消，选中态通过 opt-selected 样式区分 -->
        <view class="opt {{opt.selected ? 'opt-selected' : ''}}"
          wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="oi" wx:key="text"
          data-qi="{{index}}" data-oi="{{oi}}" bindtap="onOptionTap">
          <view class="opt-check {{opt.selected ? 'opt-check-on' : ''}}">
            <!-- 选中后显示对勾 -->
            <view wx:if="{{opt.selected}}" class="opt-tick"></view>
          </view>
          <text class="opt-text">{{opt.text}}</text>
        </view>
      </view>
    </block>

    <!-- 切题与交卷按钮：首题禁用上一题，末题显示"提交答卷" -->
    <view class="qs-actions">
      <view class="qs-btn qs-btn-plain {{current === 0 ? 'qs-btn-disabled' : ''}}"
        bindtap="prevQuestion">上一题</view>
      <view class="qs-btn qs-btn-primary" wx:if="{{current < questions.length - 1}}"
        bindtap="nextQuestion">下一题</view>
      <view class="qs-btn qs-btn-primary" wx:else bindtap="onSubmitTap">提交答卷</view>
    </view>
    <!-- 已作答统计：实时展示做题进度 -->
    <view class="qs-count">已作答 {{answeredCount}} / {{questions.length}} 题</view>
  </view>
</view>
