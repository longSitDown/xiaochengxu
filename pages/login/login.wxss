/**
 * 登录页样式
 * 版式对齐湖北省博物馆：品牌区居中 → 通栏红色主按钮 → 协议勾选 → 游客入口
 * 尺寸全部用 rpx，适配 iPhone 与安卓主流屏宽。
 */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 56rpx;
  box-sizing: border-box;
}

/* ========== 品牌区 ========== */
.brand {
  padding-top: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  /* 徽标本身是红底金星，加一圈淡金色描边呼应主题 */
  box-shadow: 0 0 0 6rpx rgba(201, 160, 99, 0.25);
}

.brand-name {
  margin-top: 36rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--primary-dark);
}

.brand-slogan {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--text-sub);
}

/* ========== 操作区 ========== */
.action {
  margin-top: 150rpx;
}

/* 开发者工具环境提示：只在 devtools 出现，真机与线上均不可见 */
.dev-tip {
  margin-bottom: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(224, 138, 0, 0.09);
  font-size: 22rpx;
  line-height: 1.6;
  color: #9A6600;
}

.dev-tip-strong {
  font-weight: 600;
  margin-right: 8rpx;
}

/* button 自带样式需重置，否则宽度/内边距与全局 .btn 打架 */
.login-btn {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 96rpx;
  letter-spacing: 2rpx;
  /* button 元素有默认 color，必须显式覆盖 */
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(200, 16, 46, 0.18);
}

.login-btn[disabled] {
  opacity: 0.75;
  color: #ffffff;
}

/* 未勾协议时的弱化态：仍是主色，但压低饱和度提示"还没准备好" */
.login-btn-dim {
  opacity: 0.62;
  box-shadow: none;
}

/* 次要按钮（手机号快捷登录）：白底描边，视觉权重低于微信登录 */
.login-btn-second {
  height: 88rpx;
  margin-top: 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  border: 2rpx solid var(--primary);
  background: #FFFFFF;
  color: var(--primary);
  box-shadow: none;
}

/* 未认证时置灰：仍可点击（点了给说明），但不吸引注意力 */
.login-btn-off {
  border-color: #DDD8D0;
  color: var(--text-light);
  background: #FCFBF9;
}

/* 两种登录方式之间的「或」分隔线 */
.or-line {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
  font-size: 22rpx;
  color: var(--text-light);
}

.or-line::before,
.or-line::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--line);
}

.or-line text {
  margin: 0 20rpx;
}

/* ========== 协议勾选 ========== */
.agree-row {
  margin-top: 36rpx;
  display: flex;
  align-items: flex-start;
}

.agree-check {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin: 4rpx 14rpx 0 0;
  border: 2rpx solid #c9c4bc;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s, border-color 0.15s;
}

.agree-check-on {
  background: var(--primary);
  border-color: var(--primary);
}

/* 纯 CSS 画的对勾：旋转 -45deg 的「L」 */
.agree-tick {
  width: 14rpx;
  height: 7rpx;
  margin-top: -4rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

.agree-link {
  color: var(--primary);
}

/* ========== 提示与游客入口 ========== */
.login-hint {
  margin-top: 20rpx;
  min-height: 34rpx;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
  color: var(--warning);
}

.skip {
  margin-top: auto;
  padding: 28rpx 0;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
}
