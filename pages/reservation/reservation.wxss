/* 预约参观（tabBar）：Hero + 入口卡 + 须知 + 我的预约 */
.page {
  padding-bottom: 40rpx;
}

/* ---- Hero：展馆建筑图 ---- */
.hero {
  position: relative;
  height: 380rpx;
  overflow: hidden;
}
.hero-img {
  width: 100%;
  height: 100%;
}
.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 4, 8, 0.1) 30%, rgba(20, 4, 8, 0.7) 100%);
}
.hero-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 40rpx 88rpx;
  color: #FFFFFF;
}
.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 226, 200, 0.95);
  margin-top: 10rpx;
}

/* ---- 预约入口卡片（悬浮压 Hero） ---- */
.entry-wrap {
  position: relative;
  margin: -64rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.entry-card {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FBF4E4 0%, #F5E9CE 100%);
  border-radius: 20rpx;
  padding: 30rpx 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(120, 8, 24, 0.10);
}
/* 左侧红绶带装饰（设计稿缎带元素） */
.entry-ribbon {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 14rpx;
  background: linear-gradient(180deg, var(--red-bright), var(--red-deep));
}
.entry-ribbon-gold {
  background: linear-gradient(180deg, #C9A063, #A07C38);
}
/* 字符徽标：红圈「个」/ 金圈「团」 */
.entry-figure {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 28rpx 0 18rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(200, 16, 46, 0.35);
}
.entry-figure-gold {
  background: linear-gradient(135deg, #C9A063, #A07C38);
  box-shadow: 0 6rpx 16rpx rgba(160, 124, 56, 0.35);
}
.entry-body {
  flex: 1;
  min-width: 0;
}
.entry-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--red-deep);
  letter-spacing: 2rpx;
}
.entry-desc {
  font-size: 24rpx;
  color: #8A6F45;
  margin-top: 8rpx;
}
.entry-arrow {
  flex-shrink: 0;
  color: var(--red-deep);
  font-size: 44rpx;
  font-weight: 300;
}

/* ---- 开放须知 / 开放时间 ---- */
.info-card {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(120, 8, 24, 0.08);
}
.info-section {
  padding: 8rpx 0;
}
.info-head {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 14rpx;
}
.info-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--gold-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 14rpx;
}
.info-text {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.8;
  padding-left: 62rpx;
}
.info-divider {
  height: 1rpx;
  background: var(--line);
  margin: 16rpx 0;
}

/* ---- 我的预约标题 ---- */
.mine-head {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 0;
}
.mine-bar {
  width: 8rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--red-bright), var(--red-deep));
  margin-right: 14rpx;
}
.mine-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ---- 我的预约：状态筛选 Tabs ---- */
.tab-scroll {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  margin-top: 20rpx;
}
.tab-list {
  display: inline-flex;
}
/* 状态 Tabs：默认浅灰底色 */
.tab-item {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #F5F3F0;
  color: var(--text-sub);
  font-size: 26rpx;
}
/* 选中的 Tab：红渐变高亮 */
.tab-active {
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  color: #FFF;
  font-weight: 500;
}

.empty-btn {
  margin-top: 24rpx;
}

/* 预约卡片：头部为类型＋状态，日期用虚线分隔 */
.resv-card {
  padding: 28rpx 24rpx;
}
.resv-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
/* 预约类型角标：默认个人（红）,团体用金色区分 */
.resv-type {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 22rpx;
}
.resv-type-group {
  background: var(--gold-light);
  color: var(--gold-text);
}
.resv-status {
  font-size: 26rpx;
  font-weight: 600;
}

.resv-date {
  display: flex;
  align-items: baseline;
  margin: 20rpx 0;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed var(--line);
}
.resv-date-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
}
.resv-date-sub {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
.resv-info {
  padding-bottom: 8rpx;
}
.resv-line {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.resv-label {
  color: var(--text-sub);
}
.resv-value {
  color: var(--text-main);
}
.resv-real {
  color: var(--primary);
  font-size: 22rpx;
}
.resv-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
.resv-time {
  font-size: 22rpx;
  color: var(--text-light);
}
.resv-arrow {
  font-size: 24rpx;
  color: var(--primary);
}
.resv-reject {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: #FDECEC;
  color: var(--danger);
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 悬浮新建按钮：右下角固定，随 iPhone 底部安全区上移，避免被遮档 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
  color: #FFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(200, 16, 46, 0.4);
  z-index: 100;
}
.fab-plus {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 2rpx;
}
