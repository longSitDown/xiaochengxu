/* 资讯详情样式 */
.detail-title {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--text-main);
}
.detail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 20rpx 0 24rpx;
  font-size: 22rpx;
  color: var(--text-light);
}
.meta-text {
  margin-left: 16rpx;
}
.detail-cover {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.detail-summary {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.8;
  padding: 20rpx 24rpx;
  background: var(--gold-light);
  border-left: 6rpx solid var(--gold);
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}
/* 正文内容 */
.detail-content {
  font-size: 30rpx;
  color: var(--text-main);
  line-height: 1.9;
  text-align: justify;
}
