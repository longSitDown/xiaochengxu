<!--
  用户协议 / 数据隐私安全声明
  query: ?type=user（默认） | privacy
-->
<view class="doc-page">
  <view class="doc-head">
    <view class="doc-title">{{docTitle}}</view>
    <view class="doc-meta">更新日期：{{updated}}</view>
  </view>

  <view class="doc-body">
    <view class="doc-section" wx:for="{{sections}}" wx:key="h">
      <view class="doc-h">{{item.h}}</view>
      <view class="doc-p" wx:for="{{item.list}}" wx:for-item="para" wx:key="id">{{para.text}}</view>
    </view>
  </view>

  <view class="doc-foot">红色纪念馆</view>
</view>
