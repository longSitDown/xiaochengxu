/* 720°全景展馆样式 */
page {
  background: #1A0A0E;
}
/* 深色暗红沉浸式背景，衬托全景展馆视角 */
.pano-page {
  min-height: 100vh;
  background: radial-gradient(ellipse at center, #2A1016 0%, #14080B 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 40rpx;
}

/* 顶部信息条：返回 + 馆名 + 更多 */
.pano-topbar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}
.pano-back,
.pano-more {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pano-back-icon {
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 1;
  margin-top: -4rpx;
}
.pano-more-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1;
  letter-spacing: -4rpx;
}
.pano-topbar-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFE9B8;
  letter-spacing: 4rpx;
}

/* 创作者 / 人气信息 */
.pano-meta {
  width: 100%;
  padding: 0 32rpx 16rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  color: rgba(255, 233, 184, 0.7);
}
.pano-meta-item {
  margin: 0 4rpx;
}
.pano-meta-dot {
  margin: 0 8rpx;
  opacity: 0.6;
}

/* 全景视口 */
.pano-viewport {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.6);
  border: 2rpx solid rgba(201, 160, 99, 0.35);
}
.pano-strip {
  position: relative;
  transition: transform 0.05s linear;
  will-change: transform;
}
/* 拖拽时关闭 transition，获得即时跟随手感 */
.pano-dragging {
  transition: none;
}
.pano-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 视角度数 */
.pano-compass {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  color: var(--gold, #C9A063);
  font-size: 24rpx;
  font-family: monospace;
}

/* 热点 */
.hotspot {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hotspot-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FFD34D;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 16rpx rgba(255, 211, 77, 0.9);
}
.hotspot-pulse {
  position: absolute;
  top: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 211, 77, 0.8);
  animation: pulse 1.6s ease-out infinite;
}
@keyframes pulse {
  0% { transform: scale(0.6); opacity: 1; }
  100% { transform: scale(2.2); opacity: 0; }
}
.hotspot-label {
  margin-top: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFE9B8;
  font-size: 20rpx;
  white-space: nowrap;
}

/* 场景标题浮层：切换章节时短暂显示 */
.pano-scene {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 60rpx;
  text-align: center;
  padding: 12rpx 32rpx;
  color: #FFE9B8;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.8);
  opacity: 0;
  transform: translateY(16rpx);
  transition: opacity 0.4s ease, transform 0.4s ease;
  pointer-events: none;
}
.pano-scene-show {
  opacity: 1;
  transform: translateY(0);
}

/* 右侧功能按钮组：信息 / 音乐 / 分享 / VR */
.pano-tools {
  position: fixed;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 50;
}
.pano-tool {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  border: 2rpx solid rgba(201, 160, 99, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.pano-tool-active {
  background: linear-gradient(135deg, #D92543, #A80F28);
  border-color: transparent;
}
.pano-tool-icon {
  color: #FFE9B8;
  font-size: 32rpx;
  line-height: 1;
}
.pano-tool-active .pano-tool-icon {
  color: #FFFFFF;
}

/* 场景缩略图：横向滚动选择视角 */
.scene-scroll {
  width: 100%;
  margin-top: 32rpx;
  white-space: nowrap;
}
.scene-list {
  display: inline-flex;
  padding: 8rpx 24rpx;
}
.scene-thumb {
  flex-shrink: 0;
  width: 160rpx;
  height: 110rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}
.scene-thumb-active {
  border-color: var(--gold, #C9A063);
}
.scene-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}
.scene-thumb-name {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 8rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFE9B8;
  font-size: 20rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部章节菜单：场馆风貌 + 各展区 */
.chapter-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}
.chapter-list {
  display: inline-flex;
  padding: 8rpx 24rpx;
}
.chapter-item {
  flex-shrink: 0;
  padding: 14rpx 34rpx;
  margin-right: 18rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.10);
  border: 2rpx solid rgba(201, 160, 99, 0.35);
  color: rgba(255, 233, 184, 0.85);
  font-size: 24rpx;
}
.chapter-active {
  background: linear-gradient(135deg, #D92543, #A80F28);
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 600;
}
