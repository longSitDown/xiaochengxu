<!-- 反馈详情 -->
<view class="page container" wx:if="{{fb}}">
  <!-- 状态 -->
  <!-- 头部：处理状态徽标 + 提交时间 -->
  <view class="card">
    <view class="fd-head">
      <view class="fd-status {{statusClass}}">{{fb.status}}</view>
      <view class="fd-time">提交于 {{createTimeText}}</view>
    </view>
    <!-- 反馈正文内容 -->
    <view class="fd-content">{{fb.content}}</view>
    <!-- 反馈图片：点击可预览大图 -->
    <view class="fd-images" wx:if="{{fb.images.length}}">
      <image wx:for="{{fb.images}}" wx:key="*this" class="fd-image"
        src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="onPreviewImage" />
    </view>
    <view class="fd-contact" wx:if="{{fb.contact}}">联系方式：{{fb.contact}}</view>
  </view>

  <!-- 处理进度时间线 -->
  <view class="card">
    <view class="block-title">
      <view class="block-bar"></view>
      <text>处理进度</text>
    </view>

    <view class="tl">
      <!-- 步骤1：已提交（始终展示） -->
      <view class="tl-item">
        <view class="tl-dot tl-dot-done"></view>
        <view class="tl-body">
          <view class="tl-title">已提交</view>
          <view class="tl-time">{{createTimeText}}</view>
        </view>
      </view>
      <!-- 步骤2：处理中（反馈非"待处理"时才展示） -->
      <view class="tl-item" wx:if="{{fb.status !== '待处理'}}">
        <view class="tl-dot tl-dot-done"></view>
        <view class="tl-body">
          <view class="tl-title">处理中</view>
          <view class="tl-time">工作人员正在跟进</view>
        </view>
      </view>
      <!-- 步骤3：官方回复（有回复时展示，附回复内容） -->
      <view class="tl-item" wx:if="{{fb.reply}}">
        <view class="tl-dot tl-dot-done"></view>
        <view class="tl-body">
          <view class="tl-title">官方回复</view>
          <view class="tl-time">{{replyTimeText}}</view>
          <view class="tl-reply">{{fb.reply}}</view>
        </view>
      </view>
      <!-- 步骤4：等待处理（无回复且状态为"待处理"时的兜底提示） -->
      <view class="tl-item" wx:if="{{!fb.reply && fb.status === '待处理'}}">
        <view class="tl-dot"></view>
        <view class="tl-body">
          <view class="tl-title tl-title-wait">等待处理</view>
          <view class="tl-time">我们会在 1-3 个工作日内处理您的反馈</view>
        </view>
      </view>
    </view>
  </view>
</view>
